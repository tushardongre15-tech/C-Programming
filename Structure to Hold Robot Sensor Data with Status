#include <stdio.h>

struct Robot
{
    int sensor1;
    int sensor2;
    int sensor3;
    char status[20];
};

int main()
{
    struct Robot r;

    printf("Enter Sensor 1: ");
    scanf("%d", &r.sensor1);

    printf("Enter Sensor 2: ");
    scanf("%d", &r.sensor2);

    printf("Enter Sensor 3: ");
    scanf("%d", &r.sensor3);

    printf("Enter Robot Status: ");
    scanf("%19s", r.status);

    printf("\nRobot Sensor Data\n");
    printf("Sensor 1 = %d\n", r.sensor1);
    printf("Sensor 2 = %d\n", r.sensor2);
    printf("Sensor 3 = %d\n", r.sensor3);
    printf("Status = %s\n", r.status);

    return 0;
}