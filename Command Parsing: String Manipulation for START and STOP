#include <stdio.h>
#include <string.h>

int main()
{
    char command[20];

    printf("Enter Command (START/STOP): ");
    scanf("%19s", command);

    if(strcmp(command, "START") == 0)
    {
        printf("Robot Started");
    }
    else if(strcmp(command, "STOP") == 0)
    {
        printf("Robot Stopped");
    }
    else
    {
        printf("Invalid Command");
    }

    return 0;
}