#include <stdio.h>
#include <time.h>

void delay()
{
    clock_t start = clock();

    while((double)(clock() - start) / CLOCKS_PER_SEC < 1.0)
    {
    }
}

int main()
{
    int i;

    for(i = 1; i <= 5; i++)
    {
        printf("LED ON\n");
        delay();

        printf("LED OFF\n");
        delay();
    }

    return 0;
}